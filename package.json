{
  "name": "kabuk",
  "productName": "Kabuk",
  "version": "1.1.0",
  "description": "Bölünmüş panelli, temalı Windows terminali",
  "author": "Kabuk",
  "homepage": "https://github.com/ysft1rt-art/kabuk",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@xterm/addon-webgl": "^0.19.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "Kabuk",
    "productName": "Kabuk",
    "copyright": "Kabuk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "contextmenu/menu.js",
      "renderer/**/*"
    ],
    "extraFiles": [
      {
        "from": "contextmenu",
        "to": "contextmenu",
        "filter": [
          "KabukMenu.dll",
          "KabukMenu.cer",
          "KabukMenu-app.msix",
          "clis.txt",
          "uninstall.ps1"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty-win32-x64/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Kabuk"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kabuk",
      "uninstallDisplayName": "Kabuk",
      "artifactName": "Kabuk-Kurulum-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ysft1rt-art",
        "repo": "kabuk",
        "releaseType": "release"
      }
    ]
  }
}
